# Managed content database
# DATABASE_URL is injected by the managed runtime. Never commit a database URL.

# Analytics
NEXT_PUBLIC_GA_ID=

# Restricted administration
# Comma-separated emails permitted to manage editorial content and submitted data.
ADMIN_EMAILS=

# Existing optional Google Sheet forwarding for established intake forms.
# Form data is always also saved to the managed database before it is forwarded.
GOOGLE_APPS_SCRIPT_URL=

# Flow Circuit authentication and application data are provided by the external
# Flow backend. Do not add provider credentials to this repository unless the
# backend architecture changes and their scope has been explicitly reviewed.
